// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

// Enum untuk role admin
enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

// Model untuk Admin/Guru BK
model Admin {
  id              String    @id @default(cuid())
  name            String
  username        String    @unique
  password        String // Should be hashed in production
  role            AdminRole @default(ADMIN)
  assignedClasses String[]  @default([]) // Kelas yang ditangani guru ini (kosong = belum ada assignment)
  
  // Profile fields
  profileImageUrl String?
  shortBio        String?   @db.Text
  bio             String?   @db.Text
  positionTitle   String?
  education       String?
  expertise       String?
  phone           String?
  emailPublic     String?
  officeLocation  String?
  officeHours     String?
  socialLinks     String?   @db.Text

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  articles        Article[]
  visits          Visit[] // Visits yang diapprove oleh admin ini
  targetedVisits  Visit[]   @relation("TargetTeacher") // Visits yang ditujukan ke guru ini
  delegatedVisits Visit[]   @relation("DelegatedTeacher") // Visits yang didelegasikan ke guru ini
  assignedVisits  Visit[]   @relation("AssignedVisits") // Visits yang saat ini di-assign ke guru ini (delegasi baru)

  @@map("admins")
}

// Model untuk Jurusan
model Major {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  classes   Class[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("majors")
}

// Model untuk Kelas
model Class {
  id        String    @id @default(cuid())
  name      String    @unique
  majorId   String
  major     Major     @relation(fields: [majorId], references: [id], onDelete: Cascade)
  students  Student[]
  visits    Visit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([majorId])
  @@map("classes")
}

// Model untuk Murid/Student
model Student {
  id        String   @id @default(cuid())
  name      String
  nisn      String   @unique
  password  String // Should be hashed
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: SetNull)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments Comment[]
  visits   Visit[]

  @@map("students")
}

// Model untuk Artikel
model Article {
  id          String   @id @default(cuid())
  title       String
  excerpt     String   @db.Text
  content     String   @db.Text
  image       String
  category    String   @default("General")
  readTime    String   @default("5 min read")
  pdfUrl      String?
  pdfFileName String?
  authorId    String
  author      Admin    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments Comment[]

  @@index([authorId])
  @@index([category])
  @@map("articles")
}

// Model untuk Komentar Artikel
model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Fields untuk anonymous comments (jika tidak login)
  name      String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@index([studentId])
  @@map("comments")
}

// Model untuk Kunjungan Murid
model Visit {
  id                     String            @id @default(cuid())
  visitDate              DateTime
  visitTime              String
  reason                 String            @db.Text
  status                 VisitStatus       @default(PENDING)
  notes                  String?           @db.Text
  approvedBy             String?
  approver               Admin?            @relation(fields: [approvedBy], references: [id], onDelete: SetNull)
  targetTeacherId        String? // Guru BK yang dipilih oleh siswa
  targetTeacher          Admin?            @relation("TargetTeacher", fields: [targetTeacherId], references: [id], onDelete: SetNull)
  studentId              String?
  student                Student?          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // Fields untuk anonymous visits (jika tidak login)
  studentName            String?
  classId                String?
  class                  Class?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  email                  String?
  phone                  String?
  // Fields untuk delegasi ke koordinator/guru lain (LEGACY)
  forwardedToCoordinator Boolean           @default(false)
  forwardReason          String?           @db.Text // Alasan guru menyerahkan ke koordinator
  delegatedToTeacherId   String?
  delegatedToTeacher     Admin?            @relation("DelegatedTeacher", fields: [delegatedToTeacherId], references: [id], onDelete: SetNull)
  delegationStatus       DelegationStatus?
  delegationNotes        String?           @db.Text
  // Fields untuk delegasi baru (desentralisasi - siswa pilih guru sendiri)
  assignedAdminId        String? // Guru BK yang saat ini ditugaskan (delegasi baru)
  assignedAdmin          Admin?            @relation("AssignedVisits", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  rejectedAdminIds       String[]          @default([]) // Daftar ID guru yang sudah menolak
  delegationStep         Int               @default(0) // Langkah delegasi ke-berapa
  // Fields untuk negosiasi waktu (siswa mengusulkan waktu baru ke guru asal)
  proposedVisitDate      DateTime?
  proposedVisitTime      String?
  timeNegotiationStep    Int               @default(0)
  timeNegotiationNotes   String?           @db.Text
  // Fields untuk fitur tunggu (waiting/hold)
  waitDurationMinutes    Int? // Durasi awal menunggu (menit)
  waitExpiredAt          DateTime? // Waktu kadaluwarsa tunggu
  visitNotesTimeline     VisitNote[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([approvedBy])
  @@index([studentId])
  @@index([classId])
  @@index([targetTeacherId])
  @@index([delegatedToTeacherId])
  @@index([assignedAdminId])
  @@index([status])
  @@index([visitDate])
  @@map("visits")
}

// Model untuk Timeline Catatan Kunjungan per Pertemuan
model VisitNote {
  id        String   @id @default(cuid())
  visitId   String
  visit     Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  note      String   @db.Text
  isSolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visitId])
  @@map("visit_notes")
}

// Enum untuk status kunjungan
enum VisitStatus {
  PENDING
  WAITING // Guru meminta siswa menunggu (hold sementara)
  AWAITING_STUDENT // Menunggu keputusan siswa (guru tidak tersedia)
  PENDING_TIME_NEGOTIATION // Siswa mengajukan jadwal baru, menunggu konfirmasi guru asal
  PENDING_DELEGATION // Siswa memilih lanjut, menunggu konfirmasi guru baru
  APPROVED
  FORWARDED
  COMPLETED
  CANCELLED
}

// Enum untuk status delegasi ke guru lain
enum DelegationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
